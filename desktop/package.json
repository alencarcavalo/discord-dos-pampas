{
  "name": "discord-dos-pampas-desktop",
  "version": "1.4.0",
  "description": "App de computador do Discord dos Pampas",
  "main": "main.js",
  "author": "Turma dos Pampas",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": { "electron": "^43.4.0", "electron-builder": "^25.1.8" },
  "build": {
    "publish": { "provider": "github", "owner": "alencarcavalo", "repo": "discord-dos-pampas", "releaseType": "release" },
    "appId": "br.pampas.discord",
    "productName": "Discord dos Pampas",
    "files": ["main.js", "preload.js", "build/icon.png"],
    "directories": { "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false },
    "artifactName": "Discord-dos-Pampas-Setup.exe"
  }
}
